DB_USERNAME=root
DB_PASSWORD=troque_pela_sua_senha
# DB_URL=jdbc:mysql://localhost:3306/rascomp?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bahia

# JWT: use pelo menos 32 caracteres e mantenha apenas no ambiente local/servidor
JWT_SECRET=troque_por_uma_chave_longa_com_32_ou_mais_caracteres
# JWT_EXPIRATION_MS=28800000
# JWT_REMEMBER_EXPIRATION_MS=2592000000

# Identidade/e-mail — V1-BETA B
# "log" imprime o link no console para desenvolvimento/homologação inicial.
# Em produção configure "resend", RESEND_API_KEY e remetente de domínio verificado.
EMAIL_PROVIDER=log
# EMAIL_FROM=RasComp <acesso@seudominio.com>
# RESEND_API_KEY=
# IDENTITY_FRONTEND_BASE_URL=http://localhost:5173
# EMAIL_VERIFICATION_HOURS=24
# PASSWORD_RESET_MINUTES=30
# IDENTITY_RESEND_COOLDOWN_SECONDS=60

# Bootstrap opcional do primeiro usuario DEV
# Depois que existir uma conta DEV, estas variaveis nao criam outra conta.
RASCOMP_DEV_NOME=Administrador RASCOMP
RASCOMP_DEV_EMAIL=dev@example.com
RASCOMP_DEV_PASSWORD=troque_por_uma_senha_forte

# Opcional: pasta local para fotos dos robos (fluxo atual permanece local)
# ROBOT_IMAGES_DIR=./uploads/robots

# Cloudflare R2 - DESATIVADO por padrao.
# Ative somente depois de criar o bucket e o token S3 no Cloudflare.
R2_ENABLED=false
# R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ras-ufrb-media
# URL publica do bucket (dominio customizado ou r2.dev, quando habilitado)
# R2_PUBLIC_BASE_URL=https://media.seudominio.example

# Frontends locais autorizados pelo CORS: gestao 5173, landing 5174 e galeria 5175.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
