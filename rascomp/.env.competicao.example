# RASCOMP - modelo do ambiente da competicao (NAO colocar segredos neste arquivo).
# Copiar para .env.competicao SOMENTE no computador servidor; nao versionar a copia.
# Este arquivo NAO e carregado automaticamente pelo Spring Boot.
# Fase 1: backend local + Aiven atual. Fase 2: MySQL local apenas apos migracao validada.
SPRING_PROFILES_ACTIVE=cloud
PORT=8080

# Preencher com as credenciais reais do Aiven apenas no arquivo privado.
DB_URL=jdbc:mysql://SEU_HOST_AIVEN:PORTA/SEU_BANCO?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=SUBSTITUIR
DB_PASSWORD=SUBSTITUIR

# Manter a chave JWT de producao quando se deseja preservar sessoes existentes.
# Nunca criar chave de exemplo em um ambiente exposto.
JWT_SECRET=SUBSTITUIR

CORS_ALLOWED_ORIGINS=https://app.rasufrb.site,https://rasufrb.site
IDENTITY_FRONTEND_BASE_URL=https://app.rasufrb.site

# Replicar configuracoes de e-mail da producao quando aplicaveis.
EMAIL_PROVIDER=resend
EMAIL_FROM=SUBSTITUIR
RESEND_API_KEY=SUBSTITUIR

# Nao habilitar bootstrap de usuario DEV em banco de producao.
# Nao definir RASCOMP_DEV_EMAIL / RASCOMP_DEV_PASSWORD.

# Uploads operacionais: garantir persistencia e copia antes da virada.
ROBOT_IMAGES_DIR=./uploads/robots
TEAM_LOGOS_DIR=./uploads/team-logos
REGISTRATION_RECEIPTS_DIR=./uploads/registration-receipts

# Nao alterar storage sem validar o uso real e migrar os arquivos.
R2_ENABLED=false

# Pool conservador do profile cloud (ajustar apenas apos teste).
DB_POOL_MAX_SIZE=4
DB_POOL_MIN_IDLE=1
