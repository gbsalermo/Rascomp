# V1-BETA B — exemplo de configuração cloud.
# NÃO copie valores reais para o Git.

SPRING_PROFILES_ACTIVE=cloud
PORT=8080

# MySQL externo/persistente
DB_URL=jdbc:mysql://CHANGE-ME:3306/rascomp?useSSL=true&serverTimezone=UTC
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

# Segurança
JWT_SECRET=CHANGE-ME-32-PLUS-CHARS
CORS_ALLOWED_ORIGINS=https://CHANGE-ME-landing.example.invalid,https://CHANGE-ME-app.example.invalid
IDENTITY_FRONTEND_BASE_URL=https://CHANGE-ME-app.example.invalid

# Primeiro DEV do banco novo
RASCOMP_DEV_NOME=Administrador RasComp
RASCOMP_DEV_EMAIL=CHANGE-ME
RASCOMP_DEV_PASSWORD=CHANGE-ME

# E-mail: manter log somente no smoke técnico inicial.
EMAIL_PROVIDER=log
EMAIL_FROM=RasComp <no-reply@CHANGE-ME.example.invalid>
RESEND_API_KEY=

# Storage R2 — ficará false até o adapter dos uploads operacionais estar concluído.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=


# Seeds/testdata são bloqueados pelo profile cloud e não devem ser habilitados.
# O único bootstrap permitido é o primeiro DEV real acima.

# Convite de primeiro acesso das contas internas
INTERNAL_ACCOUNT_SETUP_HOURS=24
