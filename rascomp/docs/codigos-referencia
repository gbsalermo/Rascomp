// CategoryService.java
package br.edu.ufrb.rascomp.service;

import br.edu.ufrb.rascomp.dto.*;
import br.edu.ufrb.rascomp.entity.*;
import br.edu.ufrb.rascomp.exception.ResourceNotFoundException;
import br.edu.ufrb.rascomp.exception.ValidationException;
import br.edu.ufrb.rascomp.repository.CategoryRepository;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.List;
import java.util.stream.Collectors;

@Service
@Transactional
public class CategoryService {

    private final CategoryRepository categoryRepository;

    public CategoryService(CategoryRepository categoryRepository) {
        this.categoryRepository = categoryRepository;
    }

    @Transactional(readOnly = true)
    public List<CategoryResponseDTO> findAll() {
        return categoryRepository.findAll().stream().map(this::toResponse).collect(Collectors.toList());
    }

    @Transactional(readOnly = true)
    public CategoryResponseDTO findById(Long id) {
        return categoryRepository.findById(id).map(this::toResponse)
                .orElseThrow(() -> new ResourceNotFoundException("Category not found: " + id));
    }

    public CategoryResponseDTO create(CategoryRequestDTO dto) {
        validateRulesConsistency(dto);

        Category category = Category.builder()
                .nome(dto.getNome())
                .codigo(dto.getCodigo())
                .descricao(dto.getDescricao())
                .tipo(dto.getTipo())
                .build();

        aplicarRegras(category, dto);

        Category saved = categoryRepository.save(category);
        return toResponse(saved);
    }

    public CategoryResponseDTO update(Long id, CategoryRequestDTO dto) {
        validateRulesConsistency(dto);

        Category category = categoryRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Category not found: " + id));

        category.setNome(dto.getNome());
        category.setCodigo(dto.getCodigo());
        category.setDescricao(dto.getDescricao());
        category.setTipo(dto.getTipo());

        // Limpa a regra antiga que não corresponde mais ao tipo atual
        // (orphanRemoval cuida de apagar a linha órfã ao salvar)
        if (dto.getTipo() == TipoCategoria.SUMO) {
            category.setRegrasSeguidorLinha(null);
        } else if (dto.getTipo() == TipoCategoria.SEGUIDOR_LINHA) {
            category.setRegrasSumo(null);
        }

        aplicarRegras(category, dto);

        Category saved = categoryRepository.save(category);
        return toResponse(saved);
    }

    public void delete(Long id) {
        Category category = categoryRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Category not found: " + id));

        // cascade = ALL cuida de apagar RegrasSumo/RegrasSeguidorLinha junto
        categoryRepository.delete(category);
    }

    private void aplicarRegras(Category category, CategoryRequestDTO dto) {
        if (dto.getTipo() == TipoCategoria.SUMO) {
            RegrasSumoDTO rs = dto.getRegrasSumo();
            RegrasSumo regras = category.getRegrasSumo() != null
                    ? category.getRegrasSumo()
                    : RegrasSumo.builder().category(category).build();

            regras.setPesoMin(rs.getPesoMin());
            regras.setPesoMax(rs.getPesoMax());
            regras.setExigeInspecao(rs.getExigeInspecao());
            regras.setMaxTentativasInspecao(rs.getMaxTentativasInspecao());

            category.setRegrasSumo(regras);
        } else if (dto.getTipo() == TipoCategoria.SEGUIDOR_LINHA) {
            RegrasSeguidorLinhaDTO rsl = dto.getRegrasSeguidorLinha();
            RegrasSeguidorLinha regras = category.getRegrasSeguidorLinha() != null
                    ? category.getRegrasSeguidorLinha()
                    : RegrasSeguidorLinha.builder().category(category).build();

            regras.setMaxTempoSegundos(rsl.getMaxTempoSegundos());
            regras.setNumeroCheckpoints(rsl.getNumeroCheckpoints());

            category.setRegrasSeguidorLinha(regras);
        }
    }

    private void validateRulesConsistency(CategoryRequestDTO dto) {
        boolean sumo = dto.getRegrasSumo() != null;
        boolean seguidor = dto.getRegrasSeguidorLinha() != null;

        if (sumo && seguidor) throw new ValidationException("Apenas uma regra deve ser preenchida conforme o tipo da categoria");
        if (!sumo && !seguidor) throw new ValidationException("A regra específica da categoria é obrigatória");

        if (dto.getTipo() == TipoCategoria.SUMO && !sumo) throw new ValidationException("regrasSumo obrigatório para tipo SUMO");
        if (dto.getTipo() == TipoCategoria.SEGUIDOR_LINHA && !seguidor) throw new ValidationException("regrasSeguidorLinha obrigatório para tipo SEGUIDOR_LINHA");
    }

    private CategoryResponseDTO toResponse(Category c) {
        CategoryResponseDTO r = new CategoryResponseDTO();
        r.setId(c.getId());
        r.setNome(c.getNome());
        r.setCodigo(c.getCodigo());
        r.setDescricao(c.getDescricao());
        r.setTipo(c.getTipo());
        r.setCreatedAt(c.getCreatedAt());

        if (c.getTipo() == TipoCategoria.SUMO && c.getRegrasSumo() != null) {
            RegrasSumo rs = c.getRegrasSumo();
            RegrasSumoDTO dto = new RegrasSumoDTO();
            dto.setPesoMin(rs.getPesoMin());
            dto.setPesoMax(rs.getPesoMax());
            dto.setExigeInspecao(rs.isExigeInspecao());
            dto.setMaxTentativasInspecao(rs.getMaxTentativasInspecao());
            r.setRegrasSumo(dto);
        } else if (c.getTipo() == TipoCategoria.SEGUIDOR_LINHA && c.getRegrasSeguidorLinha() != null) {
            RegrasSeguidorLinha rsl = c.getRegrasSeguidorLinha();
            RegrasSeguidorLinhaDTO dto = new RegrasSeguidorLinhaDTO();
            dto.setMaxTempoSegundos(rsl.getMaxTempoSegundos());
            dto.setNumeroCheckpoints(rsl.getNumeroCheckpoints());
            r.setRegrasSeguidorLinha(dto);
        }

        return r;
    }
}

// Controller
// CategoryController.java
package br.edu.ufrb.rascomp.controller;

import br.edu.ufrb.rascomp.dto.CategoryRequestDTO;
import br.edu.ufrb.rascomp.dto.CategoryResponseDTO;
import br.edu.ufrb.rascomp.service.CategoryService;
import jakarta.validation.Valid;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.net.URI;
import java.util.List;

@RestController
@RequestMapping("/api/categories")
public class CategoryController {

    private final CategoryService service;

    public CategoryController(CategoryService service) { this.service = service; }

    @GetMapping
    public ResponseEntity<List<CategoryResponseDTO>> list() {
        return ResponseEntity.ok(service.findAll());
    }

    @GetMapping("/{id}")
    public ResponseEntity<CategoryResponseDTO> get(@PathVariable Long id) {
        return ResponseEntity.ok(service.findById(id));
    }

    @PostMapping
    public ResponseEntity<CategoryResponseDTO> create(@Valid @RequestBody CategoryRequestDTO dto) {
        CategoryResponseDTO created = service.create(dto);
        return ResponseEntity.created(URI.create("/api/categories/" + created.getId())).body(created);
    }

    @PutMapping("/{id}")
    public ResponseEntity<CategoryResponseDTO> update(@PathVariable Long id, @Valid @RequestBody CategoryRequestDTO dto) {
        return ResponseEntity.ok(service.update(id, dto));
    }

    @DeleteMapping("/{id}")
    public ResponseEntity<Void> delete(@PathVariable Long id) {
        service.delete(id);
        return ResponseEntity.noContent().build();
    }
}
