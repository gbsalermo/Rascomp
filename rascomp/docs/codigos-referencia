    @Column(name = "peso_max")
    private Integer pesoMax;

    @Column(name = "exige_inspecao", nullable = false)
    private boolean exigeInspecao; // obrigatórios na configuração

    @Column(name = "max_tentativas_inspecao", nullable = false)
    private Integer maxTentativasInspecao; // obrigatório na configuração
}

